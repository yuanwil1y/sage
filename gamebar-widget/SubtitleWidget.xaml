<Page
    x:Class="ValorantTranslator.SubtitleWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:ValorantTranslator.Services"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          Margin="8,6">
        <StackPanel VerticalAlignment="Bottom" Spacing="6">
            <Border x:Name="SetupHintPanel"
                    Background="#E61A2232"
                    BorderBrush="#FF5A6CF0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9,7">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SetupHintTitle"
                               Text="正在准备小组件……"
                               Foreground="#FFF5F7FF"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SetupHintText"
                               Text="首次使用时，请点击标题栏的图钉。"
                               Foreground="#FFC7D2EB"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="#D90C1420"
                    BorderBrush="#803D5872"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="9,5">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ConnectionDot"
                                 Width="7"
                                 Height="7"
                                 Fill="#FF7EA9D3"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionStatusText"
                                   Text="正在连接 Sage……"
                                   Foreground="#FFA6C2DE"
                                   FontSize="11" />
                    </StackPanel>
                    <TextBlock x:Name="WidgetModeText"
                               Text="状态同步中"
                               Foreground="#FF879BB2"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 语音聊天：上半区 -->
            <Border Background="#D90B1724"
                    BorderBrush="#FF4D8DCC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9,7">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#FF62B6FF"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="语音聊天"
                                   Foreground="#FFEAF5FF"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="VOICE"
                                   Foreground="#FF7DB9EC"
                                   FontSize="10"
                                   CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="VoiceEmptyText"
                               Text="等待语音字幕……"
                               Foreground="#FF839BB4"
                               FontSize="12"
                               Visibility="Visible" />
                    <ItemsControl ItemsSource="{x:Bind Store.VoiceEntries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:SubtitleEntry">
                                <StackPanel Margin="0,2,0,0" Spacing="1">
                                    <TextBlock Text="{x:Bind Original}"
                                               Foreground="#FFF5F8FC"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Translated}"
                                               Foreground="#FFFFD766"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 文字聊天：下半区 -->
            <Border Background="#D9121524"
                    BorderBrush="#FFB586E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9,7">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#FFC48BFF"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="文字聊天"
                                   Foreground="#FFF8F0FF"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="TEXT"
                                   Foreground="#FFD1A9F4"
                                   FontSize="10"
                                   CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="ChatEmptyText"
                               Text="等待文字聊天……"
                               Foreground="#FF9B8EAD"
                               FontSize="12"
                               Visibility="Visible" />
                    <ItemsControl ItemsSource="{x:Bind Store.ChatEntries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:SubtitleEntry">
                                <StackPanel Margin="0,2,0,0" Spacing="1">
                                    <TextBlock Text="{x:Bind Original}"
                                               Foreground="#FFF9F6FC"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Translated}"
                                               Foreground="#FFFFD766"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
